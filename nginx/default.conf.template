# On the TLS listener a request header must not downgrade the session cookie.
# On the HTTP listener preserve the original scheme set by an external proxy.
map "$scheme:$http_x_forwarded_proto" $forwarded_proto {
    ~^https:  https;
    "http:"   http;
    default   $http_x_forwarded_proto;
}

map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ""      $http_host;
}

upstream mirror_backend {
    server ${BACKEND_UPSTREAM};
    keepalive 32;
}

server {
    include /etc/nginx/includes/listener.conf;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Let the Go backend enforce per-registry artifact size limits and storage quotas.
    client_max_body_size 0;

    # Preserve raw path encoding and slashes for protocol-specific registry endpoints.
    merge_slashes off;
    absolute_redirect off;

    # Health check
    location = /healthz {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_pass http://mirror_backend;
    }

    # Docker clients always discover their registry at /v2/ on a host.
    location ^~ /v2/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    # Multi-registry protocol endpoints: /r/{slug}/...
    # No trailing slash on proxy_pass so raw $request_uri (including %2F etc.) is preserved verbatim.
    location ^~ /r/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    # Platform API (/api/admin/*, /api/public/*) and optional root-compat protocol endpoints (/api/packages/*, /api/search)
    location ^~ /api/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    # Optional root-level Pub compatibility archive downloads (/packages/{name}/versions/{version}.tar.gz)
    location ^~ /packages/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    # Optional root-level Python index compatibility routes
    # (/simple/{project}/ for the Simple API, /legacy/ for Twine uploads)
    location ^~ /simple/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    location ^~ /legacy/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    # Optional root-level FLUTTER_STORAGE_BASE_URL compatibility routes
    location ^~ /flutter_infra_release/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    location ^~ /flutter_infra/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    location ^~ /download.flutter.io/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    location ^~ /dart-archive/ {
        include /etc/nginx/includes/proxy_params.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mirror_backend;
    }

    # Self-hosted fonts (Roboto, SIL OFL 1.1) shipped with the static SPA
    location ^~ /fonts/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # Content-hashed Nuxt static build assets
    location ^~ /_nuxt/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Ensure SPA entry HTML is always revalidated after deployments
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Static Nuxt SPA fallback (never intercepts /r/, /api/, /packages/, or /healthz)
    location / {
        try_files $uri /index.html;
    }
}

# Internal liveness check: does not require the container to trust a private CA
# or bypass certificate verification. This port is never published.
server {
    listen 127.0.0.1:8081;
    location = /healthz { proxy_pass http://mirror_backend; }
    location / { return 404; }
}
