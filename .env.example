# Public listener for docker compose. The backend's internal port stays at 8080.
BIND_HOST=0.0.0.0
BIND_PORT=80

# Administrator credentials. On first boot an empty ADMIN_PASSWORD generates a
# random password (printed once in the backend log). After that, changing
# ADMIN_PASSWORD here and recreating the backend (or `bash install.sh --reload-env`)
# updates the named administrator and revokes their other sessions.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# Optional canonical origin (including a non-default port). Blank = use request.
PUBLIC_BASE_URL=

# Optional HTTPS: mount the host directory read-only, set BOTH container paths,
# and change BIND_PORT to e.g. 443. No certificate/key is needed for HTTP.
TLS_CERT_DIR=./certs
TLS_CERT_FILE=
TLS_KEY_FILE=
# TLS_CERT_FILE=/run/depyard/tls/fullchain.pem
# TLS_KEY_FILE=/run/depyard/tls/privkey.pem
